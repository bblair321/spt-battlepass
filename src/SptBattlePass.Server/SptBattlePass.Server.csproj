<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SptBattlePass.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>0.2.1</Version>
    <AssemblyName>SptBattlePass</AssemblyName>
    <OutputPath>bin\$(Configuration)\com.bblai.battlepass\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.4" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.4" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="db\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyToSpt" AfterTargets="PostBuildEvent" Condition="Exists('$(SptInstallPath)\SPT_Runtime')">
    <ItemGroup>
      <_BattlePassDb Include="$(TargetDir)db\**\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(SptServerModsPath)\com.bblai.battlepass" />
    <MakeDir Directories="$(SptServerModsPath)\com.bblai.battlepass\db" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptServerModsPath)\com.bblai.battlepass" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SptServerModsPath)\com.bblai.battlepass" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(_BattlePassDb)" DestinationFolder="$(SptServerModsPath)\com.bblai.battlepass\db" SkipUnchangedFiles="true" />
  </Target>

</Project>
